# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : serveur uniquement (formulaire de contact, seed). Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Site ─────────────────────────────────────────────────────────────
# URL publique canonique (sitemap, Open Graph, données structurées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sel utilisé pour hacher les IP du formulaire de contact (limitation de débit). Chaîne aléatoire longue.
CONTACT_RATE_LIMIT_SALT=change-me-with-a-long-random-string

# ─── Seed (npm run db:seed) ───────────────────────────────────────────
# Si renseignés, le seed crée le compte administrateur unique.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Développement sans Supabase ──────────────────────────────────────
# DEMO_MODE=1 : le site public lit le contenu de supabase/seed/content.ts (lecture seule, admin désactivé).
DEMO_MODE=

# ─── Tests E2E admin (optionnel, nécessitent un projet Supabase de test) ─
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
